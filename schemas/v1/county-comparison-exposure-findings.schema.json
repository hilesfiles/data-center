{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/county-comparison-exposure-findings.schema.json",
  "title": "County comparison positive exposure findings",
  "type": "object",
  "required": ["schema_version", "dataset_id", "as_of", "purpose", "qualifying_rule", "interpretation_note", "findings"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "dataset_id": {"type": "string", "const": "county-comparison-exposure-findings-v1"},
    "as_of": {"type": "string", "format": "date"},
    "purpose": {"type": "string", "minLength": 1},
    "qualifying_rule": {"type": "string", "minLength": 1},
    "interpretation_note": {"type": "string", "minLength": 1},
    "findings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["title", "publisher", "url", "source_class", "accessed_on"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "source_class": {"type": "string", "enum": ["operator_primary", "government_record", "institutional_primary", "industry_directory", "research_report", "news_report"]},
        "published_on": {"type": "string", "format": "date"},
        "accessed_on": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["finding_id", "county_fips", "county_name", "state_abbr", "facility_name", "operator", "facility_category", "determination", "evidence_summary", "sources", "notes"],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^comparison-exposure-[a-z0-9-]+$"},
        "county_fips": {"$ref": "common.schema.json#/$defs/county_fips"},
        "county_name": {"type": "string", "minLength": 1},
        "state_abbr": {"$ref": "common.schema.json#/$defs/state_abbr"},
        "facility_name": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "minLength": 1},
        "facility_category": {"type": "string", "enum": ["commercial_data_center", "colocation_data_center", "enterprise_data_center", "government_data_center", "institutional_data_center", "proposed_data_center"]},
        "determination": {"type": "string", "const": "documented_qualifying_data_center_exposure"},
        "evidence_summary": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}},
        "notes": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
