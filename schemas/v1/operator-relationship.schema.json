{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/operator-relationship.schema.json",
  "title": "Operator relationship",
  "type": "object",
  "required": ["schema_version", "relationship_id", "operator_id", "subject_type", "subject_id", "relationship_type", "effective_interval", "source_claim_ids", "created_at", "updated_at", "record_status"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "relationship_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "operator_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "subject_type": {"type": "string", "enum": ["campus", "facility", "project", "project_phase"]},
    "subject_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "relationship_type": {"type": "string", "enum": ["operator", "owner", "developer", "tenant", "seller", "buyer"]},
    "effective_interval": {"$ref": "common.schema.json#/$defs/effective_interval"},
    "source_claim_ids": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/entity_id"},
      "minItems": 1,
      "uniqueItems": true
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "record_status": {"type": "string", "enum": ["active", "provisional", "superseded", "withdrawn"]}
  },
  "additionalProperties": false
}
