{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/candidate-adjudication.schema.json",
  "title": "Curated entity-resolution candidate adjudication",
  "type": "object",
  "required": ["schema_version", "resolution_candidate_id", "decision", "rationale", "evidence", "governed_rule_id"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "resolution_candidate_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "decision": {"type": "string", "enum": ["merge", "do_not_merge", "accept", "reject", "escalate"]},
    "canonical_entity_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "container_facility_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "rationale": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "finding"],
        "properties": {
          "source_id": {"$ref": "common.schema.json#/$defs/entity_id"},
          "finding": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "governed_rule_id": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "merge"}}}, "then": {"required": ["canonical_entity_id"]}},
    {"if": {"properties": {"decision": {"const": "do_not_merge"}}}, "then": {"required": ["container_facility_id"]}}
  ],
  "additionalProperties": false
}
