{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/source-artifact.schema.json",
  "title": "Acquired source artifact",
  "type": "object",
  "required": ["schema_version", "artifact_id", "source_id", "retrieved_at", "content_type", "storage_policy", "created_at", "updated_at", "record_status"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "artifact_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "source_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "request_url": {"type": "string", "format": "uri"},
    "archive_url": {"type": "string", "format": "uri"},
    "retrieved_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "content_type": {"type": "string", "minLength": 1},
    "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
    "etag": {"type": "string"},
    "last_modified": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "byte_size": {"type": "integer", "minimum": 0},
    "local_path": {"type": "string"},
    "storage_policy": {"type": "string", "enum": ["public", "repository_private", "local_gitignored", "metadata_only", "not_retained"]},
    "parser_version": {"type": "string"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "record_status": {"type": "string", "enum": ["active", "provisional", "superseded", "withdrawn"]}
  },
  "additionalProperties": false
}

