{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/acquisition-manifest.schema.json",
  "title": "Acquisition manifest",
  "type": "object",
  "required": ["schema_version", "manifest_id", "source_id", "request_url", "retrieved_at", "http_status", "license", "parser_version", "created_at", "updated_at", "record_status"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "manifest_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "source_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "source_url": {"type": "string", "format": "uri"},
    "request_url": {"type": "string", "format": "uri"},
    "retrieved_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "http_status": {"type": "integer", "minimum": 100, "maximum": 599},
    "etag": {"type": "string"},
    "last_modified": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "archive_byte_size": {"type": "integer", "minimum": 1},
    "source_member": {"type": "string", "minLength": 1},
    "member_byte_size": {"type": "integer", "minimum": 1},
    "member_crc32": {"type": "string", "pattern": "^[a-f0-9]{8}$"},
    "local_path": {"type": "string"},
    "license": {"type": "string"},
    "parser_version": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "record_status": {"type": "string", "enum": ["active", "provisional", "superseded", "withdrawn"]}
  },
  "additionalProperties": false
}
