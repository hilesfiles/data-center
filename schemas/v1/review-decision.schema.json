{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/review-decision.schema.json",
  "title": "Review decision",
  "type": "object",
  "required": ["schema_version", "review_decision_id", "review_type", "subject_refs", "decision", "reviewer", "decided_at", "created_at", "updated_at", "record_status"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "review_decision_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "review_type": {"type": "string", "enum": ["entity_match", "claim_resolution", "classification", "treatment_eligibility", "publication_eligibility", "anomaly"]},
    "subject_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["entity_type", "entity_id"],
        "properties": {
          "entity_type": {"type": "string"},
          "entity_id": {"$ref": "common.schema.json#/$defs/entity_id"}
        },
        "additionalProperties": false
      }
    },
    "decision": {"type": "string", "enum": ["accept", "reject", "merge", "do_not_merge", "provisional", "escalate", "supersede"]},
    "rationale": {"type": "string", "minLength": 1},
    "evidence_claim_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/entity_id"}, "uniqueItems": true},
    "reviewer": {
      "type": "object",
      "required": ["type", "identifier"],
      "properties": {
        "type": {"type": "string", "enum": ["human", "governed_rule"]},
        "identifier": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "decided_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "supersedes_decision_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "record_status": {"type": "string", "enum": ["active", "provisional", "superseded", "withdrawn"]}
  },
  "additionalProperties": false
}

