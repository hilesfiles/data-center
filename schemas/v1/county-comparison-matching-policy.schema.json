{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/county-comparison-matching-policy.schema.json",
  "title": "County comparison matching policy",
  "type": "object",
  "required": ["schema_version", "policy_id", "as_of", "purpose", "candidate_count_per_host", "baseline_year_count", "fallback_baseline", "feature_weights", "geography_adjustments", "selection_rules", "interpretation_limits"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"}, "policy_id": {"type": "string", "const": "county-comparison-matching-v1"},
    "as_of": {"type": "string", "format": "date"}, "purpose": {"type": "string", "minLength": 1},
    "candidate_count_per_host": {"type": "integer", "const": 5}, "baseline_year_count": {"type": "integer", "const": 5},
    "fallback_baseline": {"type": "object", "required": ["start_year", "end_year"], "properties": {"start_year": {"type": "integer", "const": 2001}, "end_year": {"type": "integer", "const": 2005}}, "additionalProperties": false},
    "feature_weights": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}},
    "geography_adjustments": {"type": "object", "required": ["different_census_region_penalty", "different_census_division_penalty"], "properties": {"different_census_region_penalty": {"type": "number", "minimum": 0}, "different_census_division_penalty": {"type": "number", "minimum": 0}}, "additionalProperties": false},
    "selection_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "interpretation_limits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }, "additionalProperties": false
}
