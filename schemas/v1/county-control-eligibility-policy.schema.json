{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/county-control-eligibility-policy.schema.json",
  "title": "County control eligibility policy",
  "type": "object",
  "required": ["schema_version", "policy_id", "as_of", "purpose", "review_scope", "negative_evidence_rule", "eligibility_rule", "required_negative_search_domains", "future_matching_requirements"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "policy_id": {"type": "string", "const": "county-control-eligibility-v1"},
    "as_of": {"type": "string", "format": "date"},
    "purpose": {"type": "string", "minLength": 1},
    "review_scope": {"type": "string", "minLength": 1},
    "negative_evidence_rule": {"type": "string", "minLength": 1},
    "eligibility_rule": {"type": "string", "minLength": 1},
    "required_negative_search_domains": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["code", "label"], "properties": {"code": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "label": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "future_matching_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
