{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/national-lifecycle-evidence-adjudication.schema.json",
  "title": "National lifecycle evidence adjudication",
  "type": "object",
  "required": ["schema_version", "national_priority_id", "resolution_state", "decision", "confidence", "rationale", "evidence", "record_status"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "national_priority_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "resolution_state": {"type": "string", "enum": ["resolved", "partial", "conflicting"]},
    "decision": {"type": "string", "enum": ["accept", "provisional", "escalate"]},
    "resolved_current_status": {"type": "string", "enum": ["proposed", "announced", "permitted", "under_construction", "operational", "partially_operational", "paused", "delayed", "cancelled", "rejected", "closed", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "rationale": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "attribute_path", "raw_value", "finding", "disposition", "claim_confidence"],
        "properties": {
          "source_id": {"$ref": "common.schema.json#/$defs/entity_id"},
          "attribute_path": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "raw_value": {"$ref": "common.schema.json#/$defs/typed_value"},
          "normalized_value": {"$ref": "common.schema.json#/$defs/typed_value"},
          "finding": {"type": "string", "minLength": 1},
          "disposition": {"type": "string", "enum": ["supporting", "conflicting", "context"]},
          "claim_confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_type", "when", "source_id", "confidence", "notes"],
        "properties": {
          "event_type": {"type": "string", "enum": ["operational", "acquired"]},
          "when": {"$ref": "common.schema.json#/$defs/temporal_extent"},
          "source_id": {"$ref": "common.schema.json#/$defs/entity_id"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "notes": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric_code", "value", "unit", "period", "source_id"],
        "properties": {
          "metric_code": {"type": "string", "enum": ["facility.capacity.mw_observed", "facility.area.building_sqft_observed"]},
          "value": {"type": "number", "minimum": 0},
          "unit": {"type": "string", "enum": ["MW", "square foot"]},
          "period": {"$ref": "common.schema.json#/$defs/temporal_extent"},
          "source_id": {"$ref": "common.schema.json#/$defs/entity_id"}
        },
        "additionalProperties": false
      }
    },
    "record_status": {"type": "string", "enum": ["active", "provisional", "superseded", "withdrawn"]}
  },
  "allOf": [
    {"if": {"properties": {"resolution_state": {"const": "resolved"}}}, "then": {"required": ["resolved_current_status"]}}
  ],
  "additionalProperties": false
}
