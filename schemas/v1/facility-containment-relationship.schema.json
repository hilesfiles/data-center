{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/facility-containment-relationship.schema.json",
  "title": "Facility containment relationship",
  "type": "object",
  "required": ["schema_version", "relationship_id", "contained_facility_id", "container_facility_id", "relationship_type", "relationship_basis", "source_claim_ids", "review_decision_id", "confidence", "created_at", "updated_at", "record_status"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "relationship_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "contained_facility_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "container_facility_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "relationship_type": {"type": "string", "const": "located_within_building"},
    "relationship_basis": {"type": "string", "enum": ["point_in_polygon_with_distinct_identity", "reviewed_source_evidence"]},
    "source_claim_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/entity_id"}, "uniqueItems": true},
    "review_decision_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "record_status": {"type": "string", "enum": ["active", "provisional", "superseded", "withdrawn"]}
  },
  "additionalProperties": false
}
