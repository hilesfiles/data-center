{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/public-county-comparison-match-index.schema.json",
  "title": "Public county comparison match index",
  "type": "object",
  "required": ["schema_version", "release_id", "generated_at", "as_of", "policy_id", "scope", "counts", "screening_sources", "positive_exposure_findings", "external_registry_unmatched_coordinate_ids", "method", "interpretation_limits", "hosts"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"}, "release_id": {"type": "string", "const": "county-comparison-matches-1.0.0"},
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "as_of": {"type": "string", "format": "date"}, "policy_id": {"type": "string", "const": "county-comparison-matching-v1"},
    "scope": {"type": "string", "minLength": 1},
    "counts": {"type": "object", "required": ["host_counties", "host_projects", "comparison_candidates", "analytical_candidates_per_host", "presentation_candidates_per_host", "unique_comparison_counties", "screened_candidate_pool_count", "candidate_specific_positive_exclusions", "externally_verified_absent"], "properties": {"host_counties": {"type": "integer", "const": 35}, "host_projects": {"type": "integer", "const": 36}, "comparison_candidates": {"type": "integer", "const": 420}, "analytical_candidates_per_host": {"type": "integer", "const": 12}, "presentation_candidates_per_host": {"type": "integer", "const": 5}, "unique_comparison_counties": {"type": "integer", "minimum": 1}, "screened_candidate_pool_count": {"type": "integer", "minimum": 1}, "candidate_specific_positive_exclusions": {"type": "integer", "minimum": 1}, "externally_verified_absent": {"type": "integer", "const": 0}}, "additionalProperties": false},
    "screening_sources": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["source_id", "title", "version", "record_count", "url", "license", "retrieved_on", "sha256"], "properties": {"source_id": {"type": "string"}, "title": {"type": "string"}, "version": {"type": "string"}, "record_count": {"type": "integer", "minimum": 1}, "url": {"type": ["string", "null"]}, "license": {"type": ["string", "null"]}, "retrieved_on": {"type": "string", "format": "date"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false}},
    "positive_exposure_findings": {"type": "object", "required": ["dataset_id", "path", "record_count", "excluded_count", "qualifying_rule", "interpretation_note", "sha256"], "properties": {"dataset_id": {"type": "string", "const": "county-comparison-exposure-findings-v1"}, "path": {"type": "string", "const": "config/v1/county-comparison-exposure-findings.json"}, "record_count": {"type": "integer", "minimum": 1}, "excluded_count": {"type": "integer", "minimum": 1}, "qualifying_rule": {"type": "string", "minLength": 1}, "interpretation_note": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "external_registry_unmatched_coordinate_ids": {"type": "array", "items": {"type": "string"}},
    "method": {"type": "object", "required": ["candidate_pool", "distance", "score", "baseline_rule", "features", "feature_weights", "geography_adjustments"], "properties": {
      "candidate_pool": {"type": "string"}, "distance": {"type": "string"}, "score": {"type": "string"}, "baseline_rule": {"type": "string"},
      "features": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "feature_weights": {"type": "object", "additionalProperties": {"type": "number"}}, "geography_adjustments": {"type": "object", "additionalProperties": {"type": "number"}}
    }, "additionalProperties": false},
    "interpretation_limits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "hosts": {"type": "array", "minItems": 35, "maxItems": 35, "items": {"$ref": "#/$defs/host"}}
  },
  "$defs": {
    "features": {"type": "object", "required": ["population_mean", "real_gdp_usd_mean", "covered_employment_mean", "weekly_wage_usd_mean", "real_gdp_per_capita_mean", "covered_employment_per_100_residents_mean", "population_growth_rate", "real_gdp_growth_rate", "covered_employment_growth_rate", "weekly_wage_growth_rate"], "properties": {
      "population_mean": {"type": "number", "minimum": 0}, "real_gdp_usd_mean": {"type": "number", "minimum": 0}, "covered_employment_mean": {"type": "number", "minimum": 0}, "weekly_wage_usd_mean": {"type": "number", "minimum": 0}, "real_gdp_per_capita_mean": {"type": "number", "minimum": 0}, "covered_employment_per_100_residents_mean": {"type": "number", "minimum": 0},
      "population_growth_rate": {"type": "number"}, "real_gdp_growth_rate": {"type": "number"}, "covered_employment_growth_rate": {"type": "number"}, "weekly_wage_growth_rate": {"type": "number"}
    }, "additionalProperties": false},
    "candidate": {"type": "object", "required": ["rank", "county_fips", "county_name", "state_abbr", "census_region", "census_division", "same_census_region", "same_census_division", "match_score", "standardized_distance", "facility_screen_status", "verification_status", "features", "history_path"], "properties": {
      "rank": {"type": "integer", "minimum": 1, "maximum": 12}, "county_fips": {"$ref": "common.schema.json#/$defs/county_fips"}, "county_name": {"type": "string"}, "state_abbr": {"$ref": "common.schema.json#/$defs/state_abbr"}, "census_region": {"type": "string"}, "census_division": {"type": "string"}, "same_census_region": {"type": "boolean"}, "same_census_division": {"type": "boolean"}, "match_score": {"type": "number", "minimum": 0, "maximum": 100}, "standardized_distance": {"type": "number", "minimum": 0}, "facility_screen_status": {"type": "string", "const": "zero_known_records_across_three_national_registries"}, "verification_status": {"type": "string", "const": "local_facility_absence_review_required"}, "features": {"$ref": "#/$defs/features"}, "history_path": {"type": "string"}
    }, "additionalProperties": false},
    "host": {"type": "object", "required": ["county_fips", "county_name", "state_abbr", "census_region", "census_division", "project_ids", "project_names", "baseline", "features", "comparison_candidates"], "properties": {
      "county_fips": {"$ref": "common.schema.json#/$defs/county_fips"}, "county_name": {"type": "string"}, "state_abbr": {"$ref": "common.schema.json#/$defs/state_abbr"}, "census_region": {"type": "string"}, "census_division": {"type": "string"}, "project_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "project_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "baseline": {"type": "object", "required": ["start_year", "end_year", "strategy", "anchor_year", "note"], "properties": {"start_year": {"type": "integer", "minimum": 2001}, "end_year": {"type": "integer", "maximum": 2024}, "strategy": {"type": "string", "enum": ["pre_documented_project_anchor", "common_early_panel_window"]}, "anchor_year": {"type": ["integer", "null"]}, "note": {"type": "string"}}, "additionalProperties": false},
      "features": {"$ref": "#/$defs/features"}, "comparison_candidates": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/candidate"}}
    }, "additionalProperties": false}
  }, "additionalProperties": false
}
