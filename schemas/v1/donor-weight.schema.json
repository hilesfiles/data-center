{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/donor-weight.schema.json",
  "title": "Matched or synthetic donor weight",
  "type": "object",
  "required": ["schema_version", "donor_weight_id", "model_run_id", "treated_geography_id", "donor_geography_id", "weight", "selection_method", "created_at", "updated_at", "record_status"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "donor_weight_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "model_run_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "treated_geography_id": {"type": "string", "minLength": 1},
    "donor_geography_id": {"type": "string", "minLength": 1},
    "weight": {"type": "number", "minimum": 0, "maximum": 1},
    "distance": {"type": "number", "minimum": 0},
    "selection_method": {"type": "string", "enum": ["mahalanobis", "propensity_caliper", "synthetic_control", "manual_research_design", "other"]},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "record_status": {"type": "string", "enum": ["active", "provisional", "superseded", "withdrawn"]}
  },
  "additionalProperties": false
}

