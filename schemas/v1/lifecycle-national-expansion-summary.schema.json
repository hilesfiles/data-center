{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/lifecycle-national-expansion-summary.schema.json",
  "title": "National lifecycle-verification expansion summary",
  "type": "object",
  "required": ["schema_version", "artifact_type", "artifact_version", "generated_at", "policy_id", "input_dataset_ids", "counts", "priority_tier_counts", "research_archetype_counts", "initial_tranche_by_region", "initial_tranche_by_state", "notices"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "artifact_type": {"type": "string", "const": "public_lifecycle_national_expansion_summary"},
    "artifact_version": {"type": "string", "minLength": 1},
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "policy_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "input_dataset_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "counts": {
      "type": "object",
      "required": ["active_canonical_facility_count", "verified_facility_count", "unknown_status_facility_count", "national_priority_record_count", "initial_tranche_facility_count", "national_backlog_facility_count", "represented_state_count", "represented_county_count", "represented_operator_count"],
      "properties": {
        "active_canonical_facility_count": {"type": "integer", "minimum": 0},
        "verified_facility_count": {"type": "integer", "minimum": 0},
        "unknown_status_facility_count": {"type": "integer", "minimum": 0},
        "national_priority_record_count": {"type": "integer", "minimum": 0},
        "initial_tranche_facility_count": {"type": "integer", "minimum": 0},
        "national_backlog_facility_count": {"type": "integer", "minimum": 0},
        "represented_state_count": {"type": "integer", "minimum": 0},
        "represented_county_count": {"type": "integer", "minimum": 0},
        "represented_operator_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "priority_tier_counts": {"type": "object"},
    "research_archetype_counts": {"type": "object"},
    "initial_tranche_by_region": {"type": "object"},
    "initial_tranche_by_state": {"type": "object"},
    "notices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
