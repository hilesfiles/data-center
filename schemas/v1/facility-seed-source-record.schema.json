{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/facility-seed-source-record.schema.json",
  "title": "Source-shaped facility seed record",
  "type": "object",
  "required": ["schema_version", "source_id", "source_artifact_id", "source_layer", "source_record_id", "source_row_id", "state_fips", "state_abbr", "county_fips", "county_name", "latitude", "longitude", "geometry", "release_vintage", "created_at"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "source_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "source_artifact_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "source_layer": {"type": "string", "enum": ["point", "building", "campus"]},
    "source_record_id": {"type": "string", "minLength": 1},
    "source_row_id": {"type": "string", "minLength": 1},
    "state_name": {"type": "string"},
    "state_fips": {"$ref": "common.schema.json#/$defs/state_fips"},
    "state_abbr": {"$ref": "common.schema.json#/$defs/state_abbr"},
    "county_fips": {"$ref": "common.schema.json#/$defs/county_fips"},
    "county_name": {"type": "string", "minLength": 1},
    "name": {"type": ["string", "null"]},
    "operator": {"type": ["string", "null"]},
    "source_ref": {"type": ["string", "null"]},
    "footprint_sqft": {"type": ["number", "null"], "minimum": 0},
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"type": "string", "enum": ["Point", "Polygon", "MultiPolygon"]},
        "coordinates": {"type": "array"}
      },
      "additionalProperties": false
    },
    "release_vintage": {"type": "string", "minLength": 1},
    "in_public_scope": {"type": "boolean"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "additionalProperties": false
}
