{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/lifecycle-national-priority-record.schema.json",
  "title": "National lifecycle-verification priority record",
  "type": "object",
  "required": [
    "schema_version",
    "national_priority_id",
    "facility_id",
    "canonical_name",
    "primary_county_fips",
    "county_name",
    "state_abbr",
    "census_region",
    "source_layer",
    "research_archetype",
    "target_attributes",
    "suggested_source_types",
    "score_components",
    "priority_score",
    "priority_tier",
    "national_rank",
    "region_rank",
    "queue_status",
    "selection_reasons",
    "prior_pilot_outcome",
    "lifecycle_status",
    "created_at",
    "updated_at",
    "record_status"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "national_priority_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "facility_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "canonical_name": {"type": "string", "minLength": 1},
    "primary_county_fips": {"$ref": "common.schema.json#/$defs/county_fips"},
    "county_name": {"type": "string", "minLength": 1},
    "state_abbr": {"$ref": "common.schema.json#/$defs/state_abbr"},
    "census_region": {"type": "string", "enum": ["Northeast", "Midwest", "South", "West"]},
    "source_layer": {"type": "string", "enum": ["point", "building"]},
    "source_ref": {"type": "string", "minLength": 1},
    "campus_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "operator_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "operator_canonical_name": {"type": "string", "minLength": 1},
    "research_archetype": {
      "type": "string",
      "enum": ["prior_review_followup", "campus_member_mapping", "exact_reference_building", "named_operator_building", "named_building", "operator_point", "low_context"]
    },
    "target_attributes": {"$ref": "lifecycle-verification-candidate.schema.json#/properties/target_attributes"},
    "suggested_source_types": {"$ref": "lifecycle-verification-candidate.schema.json#/properties/suggested_source_types"},
    "score_components": {
      "type": "object",
      "required": ["source_name_specificity", "operator_link", "building_footprint", "source_reference", "non_campus_specificity", "source_quality", "state_coverage_need", "county_density"],
      "properties": {
        "source_name_specificity": {"type": "number", "minimum": 0, "maximum": 100},
        "operator_link": {"type": "number", "minimum": 0, "maximum": 100},
        "building_footprint": {"type": "number", "minimum": 0, "maximum": 100},
        "source_reference": {"type": "number", "minimum": 0, "maximum": 100},
        "non_campus_specificity": {"type": "number", "minimum": 0, "maximum": 100},
        "source_quality": {"type": "number", "minimum": 0, "maximum": 100},
        "state_coverage_need": {"type": "number", "minimum": 0, "maximum": 100},
        "county_density": {"type": "number", "minimum": 0, "maximum": 100}
      },
      "additionalProperties": false
    },
    "priority_score": {"type": "number", "minimum": 0, "maximum": 100},
    "priority_tier": {"type": "string", "enum": ["national_high", "national_standard", "national_deferred"]},
    "national_rank": {"type": "integer", "minimum": 1},
    "region_rank": {"type": "integer", "minimum": 1},
    "initial_tranche_rank": {"type": "integer", "minimum": 1},
    "queue_status": {"type": "string", "enum": ["initial_tranche", "national_backlog"]},
    "selection_reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prior_pilot_outcome": {"type": "string", "enum": ["not_reviewed", "unresolved", "disputed"]},
    "lifecycle_status": {"type": "string", "const": "unknown"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "record_status": {"type": "string", "enum": ["active", "provisional", "superseded", "withdrawn"]}
  },
  "additionalProperties": false
}
