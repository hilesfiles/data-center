{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/public-entity-resolution-coverage.schema.json",
  "title": "Public county entity-resolution coverage",
  "type": "object",
  "required": ["schema_version", "county_fips", "county_name", "state_abbr", "release_vintage", "source_record_count", "campus_linked_facility_count", "operator_linked_record_count", "pending_candidate_count", "point_building_candidate_count", "campus_membership_candidate_count", "resolution_status", "generated_at"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "county_fips": {"$ref": "common.schema.json#/$defs/county_fips"},
    "county_name": {"type": "string", "minLength": 1},
    "state_abbr": {"$ref": "common.schema.json#/$defs/state_abbr"},
    "release_vintage": {"type": "string", "minLength": 1},
    "source_record_count": {"type": "integer", "minimum": 0},
    "campus_linked_facility_count": {"type": "integer", "minimum": 0},
    "operator_linked_record_count": {"type": "integer", "minimum": 0},
    "pending_candidate_count": {"type": "integer", "minimum": 0},
    "point_building_candidate_count": {"type": "integer", "minimum": 0},
    "campus_membership_candidate_count": {"type": "integer", "minimum": 0},
    "resolution_status": {"type": "string", "enum": ["review_pending", "governed_links_present", "source_only", "no_source_record"]},
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "additionalProperties": false
}
