{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/public-lifecycle-verification-record.schema.json",
  "title": "Public lifecycle verification record",
  "type": "object",
  "required": ["schema_version", "verification_candidate_id", "facility_id", "canonical_name", "county_fips", "county_name", "state_abbr", "evidence_status", "review_status", "resolution_status", "evidence_source_ids", "review_decision_id", "generated_at"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "verification_candidate_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "facility_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "canonical_name": {"type": "string", "minLength": 1},
    "county_fips": {"$ref": "common.schema.json#/$defs/county_fips"},
    "county_name": {"type": "string", "minLength": 1},
    "state_abbr": {"$ref": "common.schema.json#/$defs/state_abbr"},
    "evidence_status": {"type": "string", "enum": ["partial", "sufficient", "conflicting"]},
    "review_status": {"type": "string", "enum": ["in_research", "needs_review", "verified"]},
    "resolution_status": {"type": "string", "enum": ["resolved", "provisional", "disputed", "unresolved"]},
    "resolved_current_status": {"type": "string", "enum": ["proposed", "announced", "permitted", "under_construction", "operational", "partially_operational", "paused", "delayed", "cancelled", "rejected", "closed", "unknown"]},
    "resolution_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/entity_id"}},
    "review_decision_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "operational_date": {"$ref": "common.schema.json#/$defs/temporal_extent"},
    "capacity_mw": {"type": "number", "minimum": 0},
    "floor_area_sqft": {"type": "number", "minimum": 0},
    "rationale": {"type": "string", "minLength": 1},
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "allOf": [
    {"if": {"properties": {"resolution_status": {"enum": ["resolved", "provisional"]}}}, "then": {"required": ["resolved_current_status", "resolution_confidence"]}}
  ],
  "additionalProperties": false
}
