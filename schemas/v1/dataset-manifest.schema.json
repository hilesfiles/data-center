{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/dataset-manifest.schema.json",
  "title": "JSON/JSONL dataset manifest",
  "type": "object",
  "required": ["schema_version", "dataset_id", "artifact_type", "artifact_version", "generated_at", "record_schema", "format", "parts", "record_count", "license_metadata"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "dataset_id": {"type": "string", "minLength": 1},
    "artifact_type": {"type": "string", "minLength": 1},
    "artifact_version": {"type": "string", "minLength": 1},
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "data_vintage": {"type": "string"},
    "model_vintage": {"type": "string"},
    "record_schema": {"type": "string", "format": "uri"},
    "format": {"type": "string", "enum": ["json", "jsonl", "geojson"]},
    "partitioning": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "byte_size", "record_count"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "byte_size": {"type": "integer", "minimum": 0},
          "record_count": {"type": "integer", "minimum": 0},
          "partition_values": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "record_count": {"type": "integer", "minimum": 0},
    "input_dataset_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "license_metadata": {
      "type": "object",
      "required": ["license", "redistribution_status"],
      "properties": {
        "license": {"type": "string"},
        "redistribution_status": {"type": "string", "enum": ["allowed", "restricted", "metadata_only", "mixed", "unknown"]},
        "attribution": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

