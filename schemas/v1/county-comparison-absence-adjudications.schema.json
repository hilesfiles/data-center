{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/county-comparison-absence-adjudications.schema.json",
  "title": "County comparison absence adjudications",
  "type": "object",
  "required": ["schema_version", "dataset_id", "as_of", "purpose", "decision_rule", "adjudications"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "dataset_id": {"type": "string", "const": "county-comparison-absence-adjudications-v1"},
    "as_of": {"type": "string", "format": "date"},
    "purpose": {"type": "string", "minLength": 1},
    "decision_rule": {"type": "string", "minLength": 1},
    "adjudications": {"type": "array", "items": {"$ref": "#/$defs/adjudication"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["title", "publisher", "url", "source_class", "accessed_on"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "source_class": {"type": "string", "enum": ["government_record", "utility_record", "operator_primary", "institutional_primary", "industry_directory", "research_report", "news_report"]},
        "published_on": {"type": "string", "format": "date"},
        "accessed_on": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "domain_review": {
      "type": "object",
      "required": ["code", "status", "repositories", "queries", "coverage_statement", "finding", "limitations", "sources"],
      "properties": {
        "code": {"type": "string", "enum": ["planning_zoning", "economic_development_incentives", "utility_infrastructure", "environmental_permitting", "property_site_control", "company_trade_reporting", "local_news_public_debate"]},
        "status": {"type": "string", "enum": ["not_reviewed", "review_incomplete", "reviewed_no_qualifying_evidence", "qualifying_evidence_found"]},
        "repositories": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "queries": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "coverage_statement": {"type": "string", "minLength": 1},
        "finding": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
      },
      "additionalProperties": false
    },
    "adjudication": {
      "type": "object",
      "required": ["adjudication_id", "county_fips", "county_name", "state_abbr", "review_status", "control_eligibility", "reviewed_through", "completed_on", "domain_reviews", "exposure_finding_ids", "decision_rationale", "record_status"],
      "properties": {
        "adjudication_id": {"type": "string", "pattern": "^cca_[a-f0-9]{20}$"},
        "county_fips": {"$ref": "common.schema.json#/$defs/county_fips"},
        "county_name": {"type": "string", "minLength": 1},
        "state_abbr": {"$ref": "common.schema.json#/$defs/state_abbr"},
        "review_status": {"type": "string", "enum": ["verified_no_qualifying_exposure_found", "qualifying_exposure_found", "unresolved"]},
        "control_eligibility": {"type": "string", "enum": ["eligible_verified_no_known_project", "excluded_known_exposure", "unresolved_negative_evidence"]},
        "reviewed_through": {"type": "string", "format": "date"},
        "completed_on": {"type": ["string", "null"], "format": "date"},
        "domain_reviews": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/domain_review"}},
        "exposure_finding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "decision_rationale": {"type": "string", "minLength": 1},
        "record_status": {"type": "string", "enum": ["provisional", "final"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
