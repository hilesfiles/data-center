{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/public-county-control-index.schema.json",
  "title": "Public county control eligibility registry index",
  "type": "object",
  "required": ["schema_version", "release_id", "generated_at", "as_of", "policy_id", "scope", "interpretation_warning", "counts", "required_negative_search_domains", "future_matching_requirements", "states"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "release_id": {"type": "string", "const": "county-control-eligibility-1.0.0"},
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "as_of": {"type": "string", "format": "date"}, "policy_id": {"type": "string", "const": "county-control-eligibility-v1"},
    "scope": {"type": "string", "minLength": 1}, "interpretation_warning": {"type": "string", "minLength": 1},
    "counts": {"type": "object", "required": ["counties", "states", "by_exposure_status", "by_control_eligibility", "by_matching_readiness"], "properties": {
      "counties": {"type": "integer", "const": 3144}, "states": {"type": "integer", "minimum": 1},
      "by_exposure_status": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
      "by_control_eligibility": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
      "by_matching_readiness": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
    }, "additionalProperties": false},
    "required_negative_search_domains": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["code", "label"], "properties": {"code": {"type": "string"}, "label": {"type": "string"}}, "additionalProperties": false}},
    "future_matching_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "states": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["state_abbr", "path", "records", "by_exposure_status", "by_control_eligibility"], "properties": {
      "state_abbr": {"$ref": "common.schema.json#/$defs/state_abbr"}, "path": {"type": "string", "minLength": 1}, "records": {"type": "integer", "minimum": 1},
      "by_exposure_status": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "by_control_eligibility": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
    }, "additionalProperties": false}}
  },
  "additionalProperties": false
}
