{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/first-entry-research-policy.schema.json",
  "title": "County first-entry research prioritization policy",
  "type": "object",
  "required": [
    "schema_version", "policy_id", "policy_version", "treatment_definition_id",
    "input_dataset_ids", "eligibility", "regional_frame", "initial_tranche",
    "scoring", "priority_tiers", "research_protocol", "created_at", "updated_at",
    "record_status"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "policy_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "policy_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "treatment_definition_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "input_dataset_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "eligibility": {
      "type": "object",
      "required": ["active_canonical_facility_required", "complete_history_years_required", "eligible_treatments_excluded"],
      "properties": {
        "active_canonical_facility_required": {"type": "boolean", "const": true},
        "complete_history_years_required": {"type": "integer", "minimum": 1},
        "eligible_treatments_excluded": {"type": "boolean", "const": true}
      },
      "additionalProperties": false
    },
    "regional_frame": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "required": ["region", "state_abbrs"],
        "properties": {
          "region": {"type": "string", "enum": ["Northeast", "Midwest", "South", "West"]},
          "state_abbrs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/state_abbr"}}
        },
        "additionalProperties": false
      }
    },
    "initial_tranche": {
      "type": "object",
      "required": ["size", "per_region_quota", "max_per_state", "selection_order"],
      "properties": {
        "size": {"type": "integer", "minimum": 1},
        "per_region_quota": {"type": "integer", "minimum": 1},
        "max_per_state": {"type": "integer", "minimum": 1},
        "selection_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "scoring": {
      "type": "object",
      "required": ["weights", "normalization"],
      "properties": {
        "weights": {
          "type": "object",
          "required": ["dated_event_anchor", "reviewed_operational_evidence", "inventory_audit_feasibility", "panel_completeness", "source_identity_coverage"],
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 100}
        },
        "normalization": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "priority_tiers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["tier", "minimum_score", "maximum_score", "research_action"],
        "properties": {
          "tier": {"type": "string", "enum": ["first_entry_high", "first_entry_standard", "first_entry_deferred"]},
          "minimum_score": {"type": "number", "minimum": 0, "maximum": 100},
          "maximum_score": {"type": "number", "minimum": 0, "maximum": 100},
          "research_action": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "research_protocol": {
      "type": "object",
      "required": ["required_findings", "suggested_source_types", "maximum_search_rounds", "minimum_authoritative_source_types", "unverified_outcome"],
      "properties": {
        "required_findings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "suggested_source_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "maximum_search_rounds": {"type": "integer", "minimum": 1},
        "minimum_authoritative_source_types": {"type": "integer", "minimum": 1},
        "unverified_outcome": {"type": "string", "const": "unresolved_not_never_treated"}
      },
      "additionalProperties": false
    },
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "record_status": {"type": "string", "enum": ["active", "provisional", "superseded", "withdrawn"]}
  },
  "additionalProperties": false
}
