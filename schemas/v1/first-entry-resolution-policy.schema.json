{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/first-entry-resolution-policy.schema.json",
  "title": "County first-entry resolution prioritization policy",
  "type": "object",
  "required": [
    "schema_version", "policy_id", "policy_version", "treatment_definition_id",
    "predecessor_policy_id", "input_dataset_ids", "eligibility", "resolution_tracks",
    "regional_frame", "initial_tranche", "scoring", "priority_tiers",
    "research_protocol", "lineage", "created_at", "updated_at", "record_status"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "policy_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "policy_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "treatment_definition_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "predecessor_policy_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "input_dataset_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "eligibility": {
      "type": "object",
      "required": ["predecessor_research_status", "complete_history_years_required", "eligible_treatments_excluded"],
      "properties": {
        "predecessor_research_status": {"type": "string", "const": "evidence_collected"},
        "complete_history_years_required": {"type": "integer", "const": 24},
        "eligible_treatments_excluded": {"type": "boolean", "const": true}
      },
      "additionalProperties": false
    },
    "resolution_tracks": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "required": ["track", "source_resolution_state", "action"],
        "properties": {
          "track": {"type": "string", "enum": ["promote_predecessor", "resolve_existing_anchor", "establish_anchor"]},
          "source_resolution_state": {"type": "string", "enum": ["candidate_rejected_first_entry", "unresolved", "not_adjudicated"]},
          "action": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "regional_frame": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "required": ["region", "state_abbrs"],
        "properties": {
          "region": {"type": "string", "enum": ["Northeast", "Midwest", "South", "West"]},
          "state_abbrs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/state_abbr"}}
        },
        "additionalProperties": false
      }
    },
    "initial_tranche": {
      "type": "object",
      "required": ["size", "per_region_quota", "max_per_state", "exclude_tier", "selection_order"],
      "properties": {
        "size": {"type": "integer", "const": 24},
        "per_region_quota": {"type": "integer", "const": 6},
        "max_per_state": {"type": "integer", "const": 2},
        "exclude_tier": {"type": "string", "const": "resolution_foundational"},
        "selection_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "scoring": {
      "type": "object", "required": ["weights", "normalization"],
      "properties": {
        "weights": {
          "type": "object",
          "required": ["model_gate_readiness", "predecessor_promotability", "inventory_audit_feasibility", "anchor_evidence_quality", "authoritative_source_diversity", "required_finding_closure"],
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 100}
        },
        "normalization": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "priority_tiers": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "required": ["tier", "minimum_score", "maximum_score", "research_action"],
        "properties": {
          "tier": {"type": "string", "enum": ["resolution_ready", "resolution_standard", "resolution_foundational"]},
          "minimum_score": {"type": "number", "minimum": 0, "maximum": 100},
          "maximum_score": {"type": "number", "minimum": 0, "maximum": 100},
          "research_action": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "research_protocol": {
      "type": "object",
      "required": ["required_findings", "search_rounds", "maximum_search_rounds", "minimum_authoritative_source_types", "verification_requirements", "unverified_outcome"],
      "properties": {
        "required_findings": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "search_rounds": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object", "required": ["round", "name", "source_types"],
            "properties": {
              "round": {"type": "integer", "minimum": 1, "maximum": 4},
              "name": {"type": "string", "minLength": 1},
              "source_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          }
        },
        "maximum_search_rounds": {"type": "integer", "const": 4},
        "minimum_authoritative_source_types": {"type": "integer", "const": 2},
        "verification_requirements": {
          "type": "object",
          "required": ["exact_dated_anchor", "exact_facility_identity", "inventory_completeness_status", "earlier_operations_search_status"],
          "properties": {
            "exact_dated_anchor": {"type": "boolean", "const": true},
            "exact_facility_identity": {"type": "boolean", "const": true},
            "inventory_completeness_status": {"type": "string", "const": "verified_complete"},
            "earlier_operations_search_status": {"type": "string", "const": "documented_complete"}
          },
          "additionalProperties": false
        },
        "unverified_outcome": {"type": "string", "const": "unresolved_not_never_treated"}
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "required": ["append_only", "preserve_prior_adjudications", "rejected_candidate_action", "overwrite_prior_candidate"],
      "properties": {
        "append_only": {"type": "boolean", "const": true},
        "preserve_prior_adjudications": {"type": "boolean", "const": true},
        "rejected_candidate_action": {"type": "string", "const": "create_successor_candidate"},
        "overwrite_prior_candidate": {"type": "boolean", "const": false}
      },
      "additionalProperties": false
    },
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "record_status": {"type": "string", "enum": ["active", "provisional", "superseded", "withdrawn"]}
  },
  "additionalProperties": false
}
