{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/pooled-foundation-manifest.schema.json",
  "title": "Pooled-model foundation reproducibility manifest",
  "type": "object",
  "required": ["schema_version", "artifact_version", "generated_at", "source_release", "builder", "inputs", "outputs", "publication_status"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "artifact_version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_release": { "type": "string", "minLength": 1 },
    "builder": { "$ref": "#/$defs/file" },
    "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "outputs": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/output" } },
    "publication_status": { "const": "foundation_only_no_pooled_estimates" }
  },
  "additionalProperties": false,
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "sha256", "byte_size"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "byte_size": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["path", "sha256", "byte_size", "record_count"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "byte_size": { "type": "integer", "minimum": 0 },
        "record_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
