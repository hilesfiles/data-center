{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/public-facility-source-coverage.schema.json",
  "title": "Public county facility-source coverage",
  "type": "object",
  "required": ["schema_version", "county_fips", "county_name", "state_abbr", "source_id", "release_vintage", "source_record_count", "point_record_count", "building_record_count", "campus_record_count", "named_record_count", "operator_named_record_count", "observed_footprint_sqft", "cross_county_source_record_count", "coverage_status", "generated_at"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "county_fips": {"$ref": "common.schema.json#/$defs/county_fips"},
    "county_name": {"type": "string", "minLength": 1},
    "state_abbr": {"$ref": "common.schema.json#/$defs/state_abbr"},
    "source_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "release_vintage": {"type": "string", "minLength": 1},
    "source_record_count": {"type": "integer", "minimum": 0},
    "point_record_count": {"type": "integer", "minimum": 0},
    "building_record_count": {"type": "integer", "minimum": 0},
    "campus_record_count": {"type": "integer", "minimum": 0},
    "named_record_count": {"type": "integer", "minimum": 0},
    "operator_named_record_count": {"type": "integer", "minimum": 0},
    "observed_footprint_sqft": {"type": "number", "minimum": 0},
    "cross_county_source_record_count": {"type": "integer", "minimum": 0},
    "coverage_status": {"type": "string", "enum": ["source_records_present", "no_source_record"]},
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "additionalProperties": false
}
