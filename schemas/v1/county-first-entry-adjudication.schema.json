{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/county-first-entry-adjudication.schema.json",
  "title": "County first-entry evidence adjudication",
  "type": "object",
  "required": [
    "schema_version", "county_first_entry_adjudication_id",
    "first_entry_research_candidate_id", "treatment_definition_id",
    "candidate_event_evaluation_id", "county_fips", "county_name",
    "state_abbr", "resolution_state", "decision",
    "county_first_entry_verified", "inventory_completeness_status",
    "earlier_operations_search_status", "required_finding_status",
    "earlier_operational_findings", "source_ids", "authoritative_source_types",
    "rationale", "created_at", "updated_at", "record_status"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "county_first_entry_adjudication_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "first_entry_research_candidate_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "treatment_definition_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "candidate_event_evaluation_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "county_fips": {"$ref": "common.schema.json#/$defs/county_fips"},
    "county_name": {"type": "string", "minLength": 1},
    "state_abbr": {"$ref": "common.schema.json#/$defs/state_abbr"},
    "resolution_state": {
      "type": "string",
      "enum": ["candidate_rejected_first_entry", "first_entry_verified", "unresolved", "conflicting"]
    },
    "decision": {
      "type": "string",
      "enum": ["reject_candidate_as_first_entry", "accept_candidate_as_first_entry", "continue_research", "escalate"]
    },
    "county_first_entry_verified": {"type": "boolean"},
    "inventory_completeness_status": {
      "type": "string",
      "enum": ["verified_complete", "partial", "not_established"]
    },
    "earlier_operations_search_status": {
      "type": "string",
      "enum": ["documented_complete", "documented_incomplete", "not_started"]
    },
    "required_finding_status": {
      "type": "object",
      "required": [
        "earliest_dated_operational_event", "exact_facility_identity_for_earliest_event",
        "county_inventory_completeness", "documented_search_for_earlier_operations"
      ],
      "properties": {
        "earliest_dated_operational_event": {"type": "string", "enum": ["resolved", "partial", "unresolved"]},
        "exact_facility_identity_for_earliest_event": {"type": "string", "enum": ["resolved", "partial", "unresolved"]},
        "county_inventory_completeness": {"type": "string", "enum": ["resolved", "partial", "unresolved"]},
        "documented_search_for_earlier_operations": {"type": "string", "enum": ["resolved", "partial", "unresolved"]}
      },
      "additionalProperties": false
    },
    "earlier_operational_findings": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "facility_id", "canonical_name", "temporal_relation", "when",
          "source_ids", "finding", "confidence"
        ],
        "properties": {
          "facility_id": {"$ref": "common.schema.json#/$defs/entity_id"},
          "canonical_name": {"type": "string", "minLength": 1},
          "temporal_relation": {"type": "string", "enum": ["exact_operational_date", "operational_no_later_than"]},
          "when": {"$ref": "common.schema.json#/$defs/temporal_extent"},
          "source_ids": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/entity_id"}
          },
          "finding": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "source_ids": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/entity_id"}
    },
    "authoritative_source_types": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rationale": {"type": "string", "minLength": 1},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "record_status": {"type": "string", "enum": ["active", "provisional", "superseded", "withdrawn"]}
  },
  "allOf": [
    {
      "if": {"properties": {"resolution_state": {"const": "first_entry_verified"}}},
      "then": {
        "properties": {
          "decision": {"const": "accept_candidate_as_first_entry"},
          "county_first_entry_verified": {"const": true},
          "inventory_completeness_status": {"const": "verified_complete"}
        }
      },
      "else": {"properties": {"county_first_entry_verified": {"const": false}}}
    },
    {
      "if": {"properties": {"resolution_state": {"const": "candidate_rejected_first_entry"}}},
      "then": {
        "properties": {
          "earlier_operational_findings": {"minItems": 1}
        }
      }
    }
  ],
  "additionalProperties": false
}
