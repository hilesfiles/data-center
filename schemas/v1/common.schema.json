{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/common.schema.json",
  "title": "DCCIO common definitions",
  "$defs": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^[a-z]{3}_[A-Za-z0-9][A-Za-z0-9_-]{7,63}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "calendar_date": {
      "type": "string",
      "format": "date"
    },
    "year": {
      "type": "integer",
      "minimum": 1800,
      "maximum": 2200
    },
    "county_fips": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "state_fips": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    },
    "state_abbr": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "record_metadata": {
      "type": "object",
      "required": ["schema_version", "created_at", "updated_at", "record_status"],
      "properties": {
        "schema_version": {"$ref": "#/$defs/schema_version"},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "updated_at": {"$ref": "#/$defs/timestamp"},
        "record_status": {
          "type": "string",
          "enum": ["active", "provisional", "superseded", "withdrawn"]
        }
      },
      "additionalProperties": false
    },
    "external_identifier": {
      "type": "object",
      "required": ["namespace", "value"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "source_id": {"$ref": "#/$defs/entity_id"}
      },
      "additionalProperties": false
    },
    "date_precision": {
      "type": "string",
      "enum": ["day", "month", "quarter", "year", "approximate_year", "range", "unknown"]
    },
    "temporal_extent": {
      "type": "object",
      "required": ["precision"],
      "properties": {
        "date": {"$ref": "#/$defs/calendar_date"},
        "date_lower": {"$ref": "#/$defs/calendar_date"},
        "date_upper": {"$ref": "#/$defs/calendar_date"},
        "year": {"$ref": "#/$defs/year"},
        "quarter": {"type": "integer", "minimum": 1, "maximum": 4},
        "precision": {"$ref": "#/$defs/date_precision"},
        "is_inferred": {"type": "boolean", "default": false}
      },
      "allOf": [
        {
          "if": {"properties": {"precision": {"const": "day"}}},
          "then": {"required": ["date"]}
        },
        {
          "if": {"properties": {"precision": {"enum": ["year", "approximate_year"]}}},
          "then": {"required": ["year"]}
        },
        {
          "if": {"properties": {"precision": {"const": "quarter"}}},
          "then": {"required": ["year", "quarter"]}
        },
        {
          "if": {"properties": {"precision": {"const": "range"}}},
          "then": {"required": ["date_lower", "date_upper"]}
        }
      ],
      "additionalProperties": false
    },
    "effective_interval": {
      "type": "object",
      "properties": {
        "start": {"$ref": "#/$defs/temporal_extent"},
        "end": {"$ref": "#/$defs/temporal_extent"},
        "ongoing": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "coordinates": {
      "type": "object",
      "required": ["latitude", "longitude", "precision"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "precision": {
          "type": "string",
          "enum": ["rooftop", "parcel", "campus", "street", "municipality", "county", "unknown"]
        },
        "source_claim_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/entity_id"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "geography_assignment": {
      "type": "object",
      "required": ["geography_type", "geography_id", "assignment_method", "confidence"],
      "properties": {
        "geography_type": {
          "type": "string",
          "enum": ["county", "state", "municipality", "tract", "zip", "cbsa", "utility_territory", "balancing_authority", "nation"]
        },
        "geography_id": {"type": "string", "minLength": 1},
        "assignment_method": {
          "type": "string",
          "enum": ["source_reported", "point_in_polygon", "geometry_intersection", "crosswalk", "manual_review", "inherited"]
        },
        "allocation_share": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "effective_interval": {"$ref": "#/$defs/effective_interval"},
        "source_claim_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/entity_id"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "value_status": {
      "type": "string",
      "enum": ["observed", "derived", "estimated", "modeled", "imputed", "suppressed", "not_available", "not_applicable", "not_yet_released", "parser_error", "unknown"]
    },
    "typed_value": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {"type": {"const": "number"}, "value": {"type": "number"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {"type": {"const": "text"}, "value": {"type": "string"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {"type": {"const": "boolean"}, "value": {"type": "boolean"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {"type": {"const": "date"}, "value": {"$ref": "#/$defs/temporal_extent"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {"type": {"const": "identifier"}, "value": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "code"],
          "properties": {
            "type": {"const": "classification"},
            "code": {"type": "string", "minLength": 1},
            "label": {"type": "string"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value", "unit"],
          "properties": {
            "type": {"const": "quantity"},
            "value": {"type": "number"},
            "unit": {"type": "string", "minLength": 1},
            "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
            "price_basis": {"type": "string", "enum": ["nominal", "real"]},
            "base_year": {"$ref": "#/$defs/year"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type", "value"],
          "properties": {"type": {"const": "json"}, "value": {}},
          "additionalProperties": false
        }
      ]
    },
    "uncertainty": {
      "type": "object",
      "properties": {
        "lower": {"type": "number"},
        "upper": {"type": "number"},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "standard_error": {"type": "number", "minimum": 0},
        "method": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "data_quality": {
      "type": "object",
      "required": ["score", "grade", "method_version"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 100},
        "grade": {"type": "string", "enum": ["A", "B", "C", "D", "P"]},
        "method_version": {"type": "string", "minLength": 1},
        "component_scores": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        }
      },
      "additionalProperties": false
    }
  }
}

