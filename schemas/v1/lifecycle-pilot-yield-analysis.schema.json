{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/lifecycle-pilot-yield-analysis.schema.json",
  "title": "Lifecycle pilot yield analysis",
  "type": "object",
  "required": ["schema_version", "analysis_id", "input_dataset_id", "generated_at", "overall", "by_research_archetype", "failure_modes", "policy_implications"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "analysis_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "input_dataset_id": {"type": "string", "minLength": 1},
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "overall": {
      "type": "object",
      "required": ["reviewed_count", "resolved_count", "unresolved_count", "disputed_count", "resolution_rate"],
      "properties": {
        "reviewed_count": {"type": "integer", "minimum": 0},
        "resolved_count": {"type": "integer", "minimum": 0},
        "unresolved_count": {"type": "integer", "minimum": 0},
        "disputed_count": {"type": "integer", "minimum": 0},
        "resolution_rate": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "by_research_archetype": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["research_archetype", "reviewed_count", "resolved_count", "unresolved_count", "disputed_count", "resolution_rate"],
        "properties": {
          "research_archetype": {"$ref": "lifecycle-national-priority-record.schema.json#/properties/research_archetype"},
          "reviewed_count": {"type": "integer", "minimum": 0},
          "resolved_count": {"type": "integer", "minimum": 0},
          "unresolved_count": {"type": "integer", "minimum": 0},
          "disputed_count": {"type": "integer", "minimum": 0},
          "resolution_rate": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["failure_mode", "count", "policy_response"],
        "properties": {
          "failure_mode": {"type": "string", "enum": ["building_identity_not_established", "official_source_conflict"]},
          "count": {"type": "integer", "minimum": 0},
          "policy_response": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "policy_implications": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
