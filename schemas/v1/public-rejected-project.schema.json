{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/public-rejected-project.schema.json",
  "title": "Public Rejected Project",
  "$defs": {
    "summary": {
      "type": "object",
      "required": ["project_id", "site_id", "name", "proposal_sector", "developer_label", "county_fips", "county_name", "state_abbr", "disposition", "decision_date", "decision_label", "community_role", "finality", "outcome_readiness", "latitude", "longitude", "coordinate_precision", "coordinate_source_id", "detail_path", "summary", "source_count", "primary_source_count", "timeline_event_count", "timeline_start_date", "timeline_end_date"],
      "properties": {
        "project_id": {"$ref": "common.schema.json#/$defs/entity_id"},
        "site_id": {"$ref": "common.schema.json#/$defs/entity_id"},
        "name": {"type": "string", "minLength": 1},
        "proposal_sector": {"type": "string", "enum": ["data_center", "industrial", "energy", "manufacturing", "extractive", "other"]},
        "developer_label": {"type": "string", "minLength": 1},
        "county_fips": {"$ref": "common.schema.json#/$defs/county_fips"},
        "county_name": {"type": "string", "minLength": 1},
        "state_abbr": {"$ref": "common.schema.json#/$defs/state_abbr"},
        "disposition": {"type": "string", "enum": ["rejected", "withdrawn", "cancelled"]},
        "decision_date": {"$ref": "common.schema.json#/$defs/calendar_date"},
        "decision_label": {"type": "string", "minLength": 1},
        "community_role": {"type": "string", "enum": ["decisive", "contributing", "unclear"]},
        "finality": {"type": "string", "enum": ["final", "litigated", "resubmittable", "relocated", "redesigned"]},
        "outcome_readiness": {"type": "string", "enum": ["disposition_verified", "post_decision_tracking", "early_outcome_evidence", "comparison_ready"]},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "coordinate_precision": {"type": "string", "enum": ["site", "parcel", "municipality", "county"]},
        "coordinate_source_id": {"type": "string", "minLength": 1},
        "detail_path": {"type": "string", "pattern": "^rejected-projects/projects/[a-z0-9_]+\\.json$"},
        "summary": {"type": "string", "minLength": 1},
        "source_count": {"type": "integer", "minimum": 1},
        "primary_source_count": {"type": "integer", "minimum": 1},
        "timeline_event_count": {"type": "integer", "minimum": 1},
        "timeline_start_date": {"$ref": "common.schema.json#/$defs/calendar_date"},
        "timeline_end_date": {"$ref": "common.schema.json#/$defs/calendar_date"}
      }
    },
    "county_metrics": {
      "type": "object",
      "required": ["year", "real_gdp_usd", "annual_avg_covered_employment", "population", "annual_avg_weekly_wage_nominal_usd"],
      "properties": {
        "year": {"type": "integer", "minimum": 2001, "maximum": 2024},
        "real_gdp_usd": {"type": ["integer", "null"], "minimum": 0},
        "annual_avg_covered_employment": {"type": ["integer", "null"], "minimum": 0},
        "population": {"type": ["integer", "null"], "minimum": 0},
        "annual_avg_weekly_wage_nominal_usd": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {"$ref": "#/$defs/summary"},
    {
      "type": "object",
      "required": ["proposal_description", "proposed_scale", "site_afterlife", "evidence_note", "county_outcome_context", "unresolved_questions", "timeline", "sources"],
      "properties": {
        "proposal_description": {"type": "string", "minLength": 1},
        "proposed_scale": {"type": "array", "items": {"type": "object", "required": ["label", "value", "source_id"], "properties": {"label": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
        "site_afterlife": {"type": "string", "minLength": 1},
        "evidence_note": {"type": "string", "minLength": 1},
        "county_outcome_context": {
          "type": "object",
          "required": ["history_path", "history_start_year", "history_end_year", "decision_year", "last_full_pre_year", "first_full_post_year", "full_post_years_available", "analysis_status", "baseline_metrics", "latest_metrics", "note"],
          "properties": {
            "history_path": {"type": "string", "pattern": "^panels/county-economic-history/by-state/[a-z]{2}\\.json$"},
            "history_start_year": {"type": "integer", "const": 2001},
            "history_end_year": {"type": "integer", "const": 2024},
            "decision_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
            "last_full_pre_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
            "first_full_post_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
            "full_post_years_available": {"type": "integer", "minimum": 0},
            "analysis_status": {"type": "string", "const": "descriptive_only"},
            "baseline_metrics": {"$ref": "#/$defs/county_metrics"},
            "latest_metrics": {"$ref": "#/$defs/county_metrics"},
            "note": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "unresolved_questions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "timeline": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["event_id", "date", "date_label", "category", "title", "summary", "source_ids"], "properties": {"event_id": {"type": "string", "minLength": 1}, "date": {"$ref": "common.schema.json#/$defs/calendar_date"}, "date_label": {"type": "string", "minLength": 1}, "category": {"type": "string", "enum": ["proposal", "public_opposition", "government_review", "decision", "withdrawal", "litigation", "site_afterlife"]}, "title": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}, "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_id", "title", "publisher", "url", "source_type", "source_role"], "properties": {"source_id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "publisher": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}, "published_on": {"$ref": "common.schema.json#/$defs/calendar_date"}, "source_type": {"type": "string", "enum": ["government_record", "local_news", "national_news", "trade_press", "company_record", "research"]}, "source_role": {"type": "string", "enum": ["primary", "corroborating", "context"]}}, "additionalProperties": false}}
      }
    }
  ],
  "unevaluatedProperties": false
}
