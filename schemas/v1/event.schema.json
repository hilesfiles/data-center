{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/event.schema.json",
  "title": "Lifecycle event",
  "type": "object",
  "required": ["schema_version", "event_id", "event_type", "subjects", "when", "resolution_status", "created_at", "updated_at", "record_status"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "event_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "event_type": {
      "type": "string",
      "enum": ["proposed", "land_acquired", "announced", "zoning_filed", "zoning_approved", "zoning_denied", "permit_applied", "permit_issued", "construction_started", "energization_requested", "energized", "operational", "expansion_announced", "expansion_construction_started", "expansion_operational", "sold", "acquired", "operator_changed", "moratorium_affected", "legal_challenge", "delayed", "withdrawn", "rejected", "cancelled", "closed", "reopened"]
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["entity_type", "entity_id"],
        "properties": {
          "entity_type": {"type": "string", "enum": ["campus", "facility", "project", "project_phase", "operator", "policy_action"]},
          "entity_id": {"$ref": "common.schema.json#/$defs/entity_id"}
        },
        "additionalProperties": false
      }
    },
    "when": {"$ref": "common.schema.json#/$defs/temporal_extent"},
    "resolution_status": {"type": "string", "enum": ["resolved", "provisional", "disputed", "unresolved"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "source_claim_ids": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/entity_id"},
      "uniqueItems": true
    },
    "notes": {"type": "string"},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "record_status": {"type": "string", "enum": ["active", "provisional", "superseded", "withdrawn"]}
  },
  "additionalProperties": false
}

