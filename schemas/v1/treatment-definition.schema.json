{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/treatment-definition.schema.json",
  "title": "Treatment definition",
  "type": "object",
  "required": ["schema_version", "treatment_definition_id", "name", "version", "treatment_type", "qualifying_event_types", "eligibility", "time_unit", "created_at", "updated_at", "record_status"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "treatment_definition_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "treatment_type": {"type": "string", "enum": ["first_entry", "construction", "operation", "expansion", "closure", "continuous_exposure", "proposed_project_pressure"]},
    "qualifying_event_types": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "exposure_metric_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "eligibility": {
      "type": "object",
      "required": ["tier", "minimum_dqs", "minimum_date_precision", "minimum_authoritative_sources"],
      "properties": {
        "tier": {"type": "string", "enum": ["headline", "expanded", "discovery"]},
        "minimum_dqs": {"type": "number", "minimum": 0, "maximum": 100},
        "minimum_date_precision": {"type": "string", "enum": ["day", "month", "quarter", "year", "approximate_year", "unknown"]},
        "minimum_authoritative_sources": {"type": "integer", "minimum": 0},
        "minimum_source_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "spillover_rules": {
      "type": "object",
      "properties": {
        "exclude_control_within_miles": {"type": "number", "minimum": 0},
        "exclude_same_utility_territory": {"type": "boolean"},
        "neighbor_exposure_metric_codes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "time_unit": {"type": "string", "enum": ["year", "quarter"]},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "record_status": {"type": "string", "enum": ["active", "provisional", "superseded", "withdrawn"]}
  },
  "additionalProperties": false
}

