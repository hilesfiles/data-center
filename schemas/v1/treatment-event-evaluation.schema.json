{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/treatment-event-evaluation.schema.json",
  "title": "Treatment event evidence and eligibility evaluation",
  "type": "object",
  "required": [
    "schema_version", "treatment_event_evaluation_id", "event_id",
    "treatment_definition_id", "lifecycle_review_reference", "facility_id",
    "canonical_name", "county_fips", "county_name", "state_abbr", "when",
    "source_id", "source_type", "source_quality_score", "claim_confidence",
    "date_precision_multiplier", "data_quality_score", "authoritative_source_count",
    "source_count", "evidence_threshold_status", "first_entry_verification_status",
    "eligibility_status", "exclusion_reasons", "available_pre_periods",
    "available_post_periods", "period_requirement_status", "created_at",
    "updated_at", "record_status"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "treatment_event_evaluation_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "event_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "treatment_definition_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "verification_candidate_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "national_priority_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "lifecycle_review_reference": {
      "type": "object",
      "required": ["reference_type", "reference_id"],
      "properties": {
        "reference_type": {"type": "string", "enum": ["facility_verification_candidate", "national_priority"]},
        "reference_id": {"$ref": "common.schema.json#/$defs/entity_id"}
      },
      "additionalProperties": false
    },
    "facility_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "canonical_name": {"type": "string", "minLength": 1},
    "county_fips": {"$ref": "common.schema.json#/$defs/county_fips"},
    "county_name": {"type": "string", "minLength": 1},
    "state_abbr": {"$ref": "common.schema.json#/$defs/state_abbr"},
    "when": {"$ref": "common.schema.json#/$defs/temporal_extent"},
    "source_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "source_type": {"type": "string", "minLength": 1},
    "source_quality_score": {"type": "number", "minimum": 0, "maximum": 1},
    "claim_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "date_precision_multiplier": {"type": "number", "minimum": 0, "maximum": 1},
    "data_quality_score": {"type": "number", "minimum": 0, "maximum": 100},
    "authoritative_source_count": {"type": "integer", "minimum": 0},
    "source_count": {"type": "integer", "minimum": 0},
    "evidence_threshold_status": {"type": "string", "enum": ["passed", "failed"]},
    "first_entry_verification_status": {"type": "string", "enum": ["verified", "not_verified", "rejected_as_first_entry"]},
    "county_first_entry_adjudication_id": {"$ref": "common.schema.json#/$defs/entity_id"},
    "eligibility_status": {"type": "string", "enum": ["eligible", "excluded"]},
    "exclusion_reasons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "available_pre_periods": {"type": "integer", "minimum": 0},
    "available_post_periods": {"type": "integer", "minimum": 0},
    "period_requirement_status": {"type": "string", "enum": ["passed", "failed"]},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "record_status": {"type": "string", "enum": ["active", "provisional", "superseded", "withdrawn"]}
  },
  "oneOf": [
    {
      "required": ["verification_candidate_id"],
      "not": {"required": ["national_priority_id"]},
      "properties": {"lifecycle_review_reference": {"properties": {"reference_type": {"const": "facility_verification_candidate"}}}}
    },
    {
      "required": ["national_priority_id"],
      "not": {"required": ["verification_candidate_id"]},
      "properties": {"lifecycle_review_reference": {"properties": {"reference_type": {"const": "national_priority"}}}}
    }
  ],
  "additionalProperties": false
}
