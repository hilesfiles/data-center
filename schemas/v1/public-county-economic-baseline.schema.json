{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dccio.org/schemas/v1/public-county-economic-baseline.schema.json",
  "title": "Public county economic baseline",
  "type": "object",
  "required": [
    "schema_version",
    "county_fips",
    "county_name",
    "state_abbr",
    "year",
    "real_gdp_usd",
    "personal_income_nominal_usd",
    "population",
    "per_capita_personal_income_nominal_usd",
    "coverage_status",
    "source_ids",
    "release_vintage",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "county_fips": {"$ref": "common.schema.json#/$defs/county_fips"},
    "county_name": {"type": "string", "minLength": 1},
    "state_abbr": {"$ref": "common.schema.json#/$defs/state_abbr"},
    "year": {"type": "integer", "minimum": 1900, "maximum": 2200},
    "real_gdp_usd": {"type": ["integer", "null"], "minimum": 0},
    "personal_income_nominal_usd": {"type": ["integer", "null"], "minimum": 0},
    "population": {"type": ["integer", "null"], "minimum": 0},
    "per_capita_personal_income_nominal_usd": {"type": ["integer", "null"], "minimum": 0},
    "coverage_status": {"type": "string", "enum": ["complete", "partial", "unavailable"]},
    "source_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/entity_id"}, "minItems": 1, "uniqueItems": true},
    "release_vintage": {"type": "string", "minLength": 1},
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "additionalProperties": false
}
